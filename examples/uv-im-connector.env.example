UV_IM_ADDR=127.0.0.1:8787
UV_IM_STATE_DIR=/var/lib/uv-im-connector
UV_IM_AUTH_TOKEN=change-me
UV_IM_PROVIDERS=memory
# Optional verified account bindings; see docs/identities.md for the JSON format.
UV_IM_USER_IDENTITIES_FILE=

UV_WECOM_CONNECTOR_ID=wecom
UV_WECOM_BOT_ID=
UV_WECOM_BOT_SECRET=
# Optional enterprise directory identity. Configure both, or leave both empty.
# CorpID: admin console > My Enterprise > Enterprise Information (not AgentId).
# CorpSecret: Application Management > self-built application > Secret (not bot Secret).
# Add the connector server's public egress IP to that application's trusted IPs.
# Setup and verification: docs/guide/wecom.md
UV_WECOM_CORP_ID=
UV_WECOM_CORP_SECRET=
UV_WECOM_WS_URL=

UV_LARK_CONNECTOR_ID=lark
UV_LARK_APP_ID=
UV_LARK_APP_SECRET=
UV_LARK_REGION=feishu
UV_LARK_BOT_OPEN_ID=
UV_LARK_BOT_UNION_ID=
UV_LARK_BASE_URL=
UV_LARK_CALLBACK_BASE_URL=
